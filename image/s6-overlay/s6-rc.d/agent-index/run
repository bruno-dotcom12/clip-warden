#!/bin/sh
# Report this agent's token usage to the Agent Index, hourly.
#
# NO SWITCH. The reporter is here because somebody put it in this image, and
# that is the decision: an agent whose owner does not want their usage on the
# index is one built without this service. A flag would re-ask a question the
# Dockerfile has already answered, in a second place that can disagree with it.
#
# Baked in rather than bind-mounted: a mount whose source is missing does not
# fail, it creates a DIRECTORY at the target, and the reporter starts against a
# directory and reports nothing. Built in, the file is in the image or the
# build failed.

# Absolute, for the same reason the calendar feed's is: a service inherits the
# supervision tree's PATH, not a login shell's.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# Written by first boot from the credential the host dropped in, 0600 root --
# read here, before dropping to the agent's uid. AGENT_ID is which agent this
# is; without it there is nothing to report FOR, so the service stands down
# rather than guessing a name.
PLOW_AGENT_TOKEN=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID

# The agent's home is where its usage store lives, and the client keeps its
# ledger beside that store. Fixed, not overridable: this image puts the home
# there, and a second way to say where it is only creates the case where the
# reporter and the agent disagree about which store is theirs.
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment, so there is no" >&2
  echo "agent to report for -- standing down. Set it where this container is" >&2
  echo "started (plow-agents compose.yml)." >&2
  exec sleep 86400
fi

# The uid the Dockerfile gives the agent. Numeric, and the same literal the
# Dockerfile uses: `hermes` is a name this image assigns, and a chown by name
# fails as an error nobody reads if a future base renames it.
HERMES_UID=10000
HERMES_GID=10000

# Hand the reporter's own state back to the agent, every hour, before asking
# the client anything.
#
# WHY THIS EXISTS: measured 15/09/2026 -- `/var/lib/hermes/.agent-index.json`
# was owned by root since 14:15, because a `docker compose exec` that entered
# as root ran the client and the client created its state as root. The client
# runs as hermes (uid 10000); it exits 2, "Permission denied", and every hour
# after that reports nothing. The damage is silent: the service keeps looping
# and the Index simply stops hearing from this install.
#
# WHY `-h`, AND WHY SYMLINKS ARE SKIPPED OUTRIGHT: $HERMES_HOME is a directory
# the agent itself controls. A chown that FOLLOWS a symlink lets hermes point
# `.agent-index.json` at /etc/shadow and be handed ownership of the target by a
# root process. That is privilege escalation, written by us, once an hour. So
# this refuses to touch anything that is a symlink, and `-h` is kept as the
# second lock: even if the test were wrong, chown would act on the link and
# never on what it points at.
#
# Not fatal either way. A home where this cannot be fixed is a bad hour, and a
# bad hour is reported below rather than crashing a longrun into a respawn loop.
# Inside the loop, not once at boot: root can break this again at any hour of
# an install's life -- that is exactly how it broke -- and a repair that only
# ran at boot would need a restart to take, which is the one thing an owner
# with a session open should not have to do.
devolve_o_estado() {
  for f in "$HERMES_HOME"/.agent-index*.json "$HERMES_HOME/.agent-index.lock"; do
    # An unmatched glob stays literal in sh, so the path is tested, not assumed.
    [ -e "$f" ] || [ -L "$f" ] || continue
    if [ -L "$f" ]; then
      echo "agent-index: $f is a symlink -- not touching it. The agent's own" >&2
      echo "home is not a place root follows links into." >&2
      continue
    fi
    /bin/chown -h "$HERMES_UID:$HERMES_GID" "$f" 2>/dev/null \
      || echo "agent-index: could not give $f back to uid $HERMES_UID" >&2
  done
}

while :; do
  devolve_o_estado

  # The pinned client owns assertion exchange, aik_ format and atomic storage.
  # The image only invokes it; no image-owned HTTP path can hand the broad Plow
  # bearer to the Index.
  # Registered already? The client owns that question. Where this install's
  # state lives is its business, and it MOVES it -- this gate used to test
  # $HERMES_HOME/.agent-index/token, a path the client only ever DELETES once
  # its own state file holds the key. The test was true forever, so every tenant
  # re-registered on the hour and minted a fresh key each time.
  #
  #   0  registered      3  not registered      2  state is there, unreadable
  #
  # 2 is not 3, and this must not collapse them: registering over state the
  # client could not read mints against a new install id and strands the usage
  # this install has already published. That hour is skipped instead. The
  # contract and why it has three answers are in the client's README.
  #
  # stdout is dropped -- it says the same thing every hour. stderr is not: on 2
  # it carries the client's account of WHICH file it could not read.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      /command/s6-setuidgid hermes \
        env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
        /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
        --register --agent "$AGENT_ID" >/dev/null || {
      echo "agent-index: no index key this hour, not reporting" >&2
      /bin/sleep 3600
      continue
      }
      ;;
    *)
      echo "agent-index: the client could not read this install's state (above);" >&2
      echo "standing off rather than registering over it." >&2
      /bin/sleep 3600
      continue
      ;;
  esac

  # No PLOW_AGENT_TOKEN in this environment. The client finds the key the
  # exchange stored in the agent's home and reports with that.
  #
  # Never fatal. A collector that failed says so and exits non-zero; a crashing
  # longrun would be respawned in a tight loop, which turns one bad hour into a
  # hot loop against the index.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero, see the line above" >&2
  /bin/sleep 3600
done
