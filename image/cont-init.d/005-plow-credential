#!/bin/sh
# A credencial da Plow, do bind para o caminho que o runtime lê.
#
# POR QUE ESTE ARQUIVO EXISTE, e ele é o conserto de um defeito medido em
# 16/09/2026: o `compose.yml` monta `./plow-credentials` em
# `/var/lib/plow/credentials.host` e o comentário dele dizia, com estas
# palavras, que "a imagem copia o arquivo para o lugar, como root". NÃO COPIAVA.
# Nem esta imagem nem a base tinham uma linha que fizesse isso -- conferido nas
# duas, com grep. O `plow-init.py` espera `/var/lib/plow/credentials`, não o
# `.host`, e sem esse arquivo ele espera 60 segundos e ESTACIONA:
#
#   plow-init: no PLOW_API_BASE in the environment and no credential at
#   /var/lib/plow/credentials after 60s -- parking; no gateway will start
#
# O que isso custava: uma instalação LOCAL nova subia inteira, sem erro
# nenhum na tela, e não respondia a ninguém -- o agente não estava na linha.
# Os containers que funcionavam tinham o arquivo posto à mão numa camada de
# escrita que sobrevive a `stop`/`start` e MORRE num `recreate`. Ou seja: o
# defeito aparecia na primeira vez e depois de todo `docker compose up
# --force-recreate`, que são exatamente os dois momentos em que ninguém
# desconfia da credencial.
#
# NA NUVEM DA PLOW ISSO NUNCA APARECEU, e é por isso que ficou tanto tempo de
# pé: lá `PLOW_API_BASE` vem no ambiente, `read_credentials()` toma o caminho
# do ambiente e o arquivo não é lido. O defeito é só de quem hospeda por conta
# própria -- que é quem lê o docs/INSTALL.md.
set -eu

HOST=/var/lib/plow/credentials.host
ALVO=/var/lib/plow/credentials

# Sem o bind não há o que copiar, e isso é normal: quem roda na nuvem da Plow
# recebe tudo pelo ambiente. Sair 0 aqui deixa o `plow-init` seguir pelo
# caminho dele em vez de a instalação inteira morrer por falta de um arquivo
# que ela não precisava.
[ -f "$HOST" ] || exit 0

# `-f` acima e `-L` aqui: um symlink no lugar do bind faria este `cat`, que
# roda como root, ler um arquivo escolhido por outra pessoa e gravá-lo como a
# credencial do agente.
[ -L "$HOST" ] && exit 0

# Já no lugar: não se sobrescreve. Um `docker compose up` sobre um agente que
# já rodou trocaria a credencial viva pela do arquivo do host, que pode ser de
# uma linha anterior -- e o agente sairia da linha em que estava.
[ -e "$ALVO" ] && exit 0

# As exigências são do `plow-init.py`, verbatim: arquivo regular, root:root, e
# modo 0600 ou 0400. Qualquer outra coisa ele recusa e estaciona -- inclusive
# 0644, que entregaria a credencial a toda conta do container. O `umask` faz o
# arquivo NASCER 0600 em vez de nascer legível e ser corrigido depois.
umask 077
rm -f "$ALVO.tmp"
cat "$HOST" > "$ALVO.tmp"
chown 0:0 "$ALVO.tmp"
chmod 0600 "$ALVO.tmp"
# Escrito ao lado e renomeado por cima: uma cópia interrompida no meio deixaria
# uma credencial truncada, e o `plow-init` a recusaria com uma mensagem sobre
# chaves indocumentadas em vez de sobre um arquivo pela metade.
mv -f "$ALVO.tmp" "$ALVO"
echo "[plow-credential] copiei $HOST -> $ALVO (root:root 0600)"
