#!/bin/sh
# Pull the transcription models once, in the background, at boot.
#
# Baking them into the image cost every installer 600 MB before the agent had
# said a word, on a leaderboard that counts installs that finish. Fetching them
# on first use instead would move that cost into a stranger's first request,
# which is worse: a silent five-minute wait is indistinguishable from a broken
# agent. So it happens here, while the owner is reading the welcome message.
#
# Never fatal. No models means transcription falls back to downloading one when
# it is first needed, which is slow but correct; a crash here would take the
# whole agent down over a file it can fetch later.
#
# It also writes what it is doing to `$HF_HOME/fetch-state`, one `size=state`
# per line. That file is the difference between `warden status` saying "still
# downloading, or not fetched yet" -- which is two different things and no way
# to tell them apart -- and it saying which model, and how far along. The first
# `warden cut` of a fresh install lands exactly in this window.
set -eu
HF_HOME="${HF_HOME:-/var/lib/hermes/models}"
export HF_HOME
mkdir -p "$HF_HOME"
ESTADO="$HF_HOME/fetch-state"

marca() { printf '%s=%s\n' "$1" "$2" >> "$ESTADO"; }

: > "$ESTADO"
marca started "$(date -u +%s)"
# The order is `base` first, and it is not alphabetical or arbitrary: whoever
# arrives first is whoever unlocks the first clip. The first command a stranger
# runs is `warden lote prep`, which transcribes the WHOLE source only to choose
# a moment from it, and that pass picks `base` (145 MB). `small` (484 MB) is for
# the window that was already chosen, whose words get burned in -- the second
# command, not the first. Fetching `small` first made the stranger wait for
# 629 MB before their first clip instead of 145 MB, for a model that pass never
# calls.
for size in base small; do
  marca "$size" fetching
  if /opt/hermes/.venv/bin/python3 - "$size" <<'PY'
import sys
from faster_whisper import WhisperModel
WhisperModel(sys.argv[1], device="cpu", compute_type="int8")
print(f"warden-models: {sys.argv[1]} ready")
PY
  then
    marca "$size" ready
  else
    marca "$size" failed
    echo "warden-models: $size not fetched this boot; it will be fetched when first needed" >&2
  fi
done
marca finished "$(date -u +%s)"
