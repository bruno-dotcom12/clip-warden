.env
__pycache__/
.pytest_cache/
# The agent credential `plow-agents mint` writes here. A live bearer token.
plow-credentials

# Fetched by hand when registering on the Index. The image fetches its own
# copy at build, pinned by sha in vendor/client.pin, so a loose copy here would
# only drift from the one that actually runs.
agent_index_client.py

# Build output, so a failed build can be read from here without being published.
build.log
check.log
.DS_Store

# O checkout do plow-agents que o install.sh traz para dentro do repo,
# para o host não ter uma pasta solta a mais para apagar depois.
.plow-agents/

# exportes de conversa do container, nunca publicar
logs-*/

# Estado do agente, quando alguém aponta WARDEN_DIR para dentro do checkout.
# Fora do container `state_dir()` é ~/.clip-warden e nada disto aparece aqui --
# mas `WARDEN_DIR=. ` num teste rápido põe o livro de entregas, as preferências
# e a lista de links da PESSOA dentro do repositório, e este repositório é
# público. Ignorar é mais barato que lembrar.
renders.json
entregas.json
preferences.json
trusted.json
links.json
campaigns/
footage/
clips/
cookies.txt
